# Copy to .env, then run ./scripts/generate-env.sh before production startup.
TELNEXA_IMAGE_TAG=local
JASMIN_IMAGE=jookies/jasmin:0.11.0@sha256:3f049692d22fd66ab08a55073f79db96fe442473ede9615e8ac085ac505a1064

SMS_DOMAIN=sms.telnexa.co
API_DOMAIN=api.telnexa.co
PORTAL_DOMAIN=app.telnexa.co
ADMIN_DOMAIN=admin.telnexa.co
LETSENCRYPT_EMAIL=operations@example.com
HTTP_BIND_ADDRESS=0.0.0.0
HTTPS_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

RABBITMQ_USER=telnexa
RABBITMQ_PASSWORD=GENERATE_ME
REDIS_PASSWORD=GENERATE_ME

JASMIN_ADMIN_USER=telnexa-admin
JASMIN_ADMIN_PASSWORD=GENERATE_ME
JASMIN_API_GROUP=telnexa-api
JASMIN_API_USER=middleware
JASMIN_API_PASSWORD=GENERATE_ME
JASMIN_HTTP_THROUGHPUT=20
JASMIN_SMPPS_THROUGHPUT=20

# Leave empty until the middleware HTTPS endpoint is available.
WEBHOOK_TARGET_BASE_URL=
WEBHOOK_HMAC_SECRET=GENERATE_ME
WEBHOOK_TIMEOUT_SECONDS=10
TELNEXA_PROVIDER_KEYS_FILE=/etc/telnexa/secrets/provider-keys.json
TELNEXA_METRICS_TOKEN_FILE=/etc/telnexa/secrets/metrics-token
OIDC_ALLOWED_AZP=telnexa-portal

# Billing PostgreSQL is private to the billing network.
BILLING_DB_NAME=telnexa_billing
BILLING_DB_USER=telnexa_billing
BILLING_DB_PASSWORD=GENERATE_ME
BILLING_JWT_SECRET=GENERATE_ME
BILLING_ADMIN_TOKEN=GENERATE_ME
BILLING_MIDDLEWARE_URL=https://10.40.0.1/api/v1/events/telnexa
BILLING_MIDDLEWARE_API_KEY=GENERATE_ME
BILLING_MIDDLEWARE_HMAC_SECRET=GENERATE_ME
BILLING_SIMULATOR_ENABLED=true
LIVE_SMS_DELIVERY=false
LIVE_EMAIL_DELIVERY=false
EXTERNAL_SMS_DELIVERY=false
EXTERNAL_EMAIL_DELIVERY=false
PRODUCTION_PROVIDER_ROUTING=false
MARKETING_DELIVERY=false

GRAFANA_ADMIN_USER=telnexa-admin
GRAFANA_ADMIN_PASSWORD=GENERATE_ME
GRAFANA_DOMAIN=monitoring.telnexa.co
