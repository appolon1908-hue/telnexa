limit_req_zone $binary_remote_addr zone=sms_api:10m rate=20r/s;
log_format telnexa_noargs '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';

server {
    listen 80 default_server;
    server_name ${SMS_DOMAIN} ${API_DOMAIN} ${PORTAL_DOMAIN} ${ADMIN_DOMAIN};
    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SMS_DOMAIN};
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/${SMS_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SMS_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TelnexaTLS:10m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    access_log /var/log/nginx/access.log telnexa_noargs;

    location = /healthz { access_log off; default_type application/json; return 200 '{"status":"ok","tls":true}'; }
    location / {
        limit_req zone=sms_api burst=40 nodelay;
        proxy_pass http://jasmin:1401;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
        client_max_body_size 64k;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/${SMS_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SMS_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location = /healthz { proxy_pass http://billing-api:8000/health; }
    location / { limit_req zone=sms_api burst=40 nodelay; proxy_pass http://billing-api:8000; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto https; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; client_max_body_size 1m; }
}

server {
    listen 443 ssl; http2 on; server_name ${PORTAL_DOMAIN} ${ADMIN_DOMAIN}; server_tokens off;
    ssl_certificate /etc/letsencrypt/live/${SMS_DOMAIN}/fullchain.pem; ssl_certificate_key /etc/letsencrypt/live/${SMS_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3; add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosn always; add_header X-Frame-Options DENY always;
    location / { proxy_pass http://billing-api:8000; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto https; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; }
}
